DATABASE_URL=postgres://postgres:postgres@localhost:5432/finapp
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/finapp

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Do not expose this through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Keep local development on seeded context until hosted auth is ready.
# Set to "supabase" in hosted environments after onboarding/RLS are wired.
FINAPP_AUTH_MODE=dev
